<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>csharp-signature-runner</AssemblyName>
    <RootNamespace>CSharpSignatureRunner</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the audit baseline. Do NOT float this version. -->
    <PackageReference Include="Neo" Version="3.10.1" />
    <PackageReference Include="Neo.VM" Version="3.10.1" />
  </ItemGroup>

</Project>
