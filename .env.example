# Neo-N3 Monitoring Configuration Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# SMTP Configuration (for email notifications)
# ============================================================================

# SMTP server password for sending alerts
SMTP_PASSWORD=your-smtp-server-password

# Optionally override other SMTP settings if needed:
# SMTP_HOST=smtp.r3e.network
# SMTP_PORT=587
# SMTP_USERNAME=neo-monitoring@r3e.network

# ============================================================================
# Slack Webhook Integration
# ============================================================================

# Incoming webhook URL for Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# If you want separate channels for different severity levels, you can add:
# SLACK_CRITICAL_WEBHOOK_URL=https://hooks.slack.com/services/CRITICAL/WEBHOOK/URL
# SLACK_WARNING_WEBHOOK_URL=https://hooks.slack.com/services/WARNING/WEBHOOK/URL
# SLACK_INFO_WEBHOOK_URL=https://hooks.slack.com/services/INFO/WEBHOOK/URL

# ============================================================================
# PagerDuty Integration (optional, for critical alerts only)
# ============================================================================

# Your PagerDuty service key for triggering incidents
PAGERDUTY_SERVICE_KEY=your-pagerduty-service-key

# ============================================================================
# Grafana Configuration
# ============================================================================

# Grafana admin password (change from default 'admin')
GRAFANA_ADMIN_PASSWORD=secure-admin-password

# Optional: Configure Grafana data source authentication
# GRAFANA_DATASOURCE_USER=prometheus-user
# GRAFANA_DATASOURCE_PASSWORD=prometheus-password

# ============================================================================
# Docker Compose Secrets
# ============================================================================

# For Docker deployment, these secrets will be passed via environment variables
# The docker-compose file uses ${VARIABLE:-default} syntax for fallbacks

# Email recipients (configured in alertmanager.yml)
# OPS_EMAIL=ops-team@r3e.network
# CRITICAL_EMAIL=ops-critical@r3e.network

# ============================================================================
# Prometheus Configuration
# ============================================================================

# Storage retention period (days)
# PROMETHEUS_RETENTION_TIME=30d

# Scrape interval adjustment
# PROMETHEUS_SCRAPE_INTERVAL=10s

# ============================================================================
# Usage Instructions
# ============================================================================

# 1. Create this file:
#    cp .env.example .env

# 2. Edit .env and fill in your credentials

# 3. Start monitoring stack with Docker:
#    docker-compose -f monitoring-docker-compose.yml --env-file .env up -d

# 4. Or start services manually:
#    export $(cat .env | xargs)
#    ./scripts/setup-monitoring.sh

# 5. Access the services:
#    - Prometheus:   http://localhost:9090
#    - Alertmanager: http://localhost:9093
#    - Grafana:      http://localhost:3000 (login: admin / ${GRAFANA_ADMIN_PASSWORD})

# 6. Test notifications:
#    # Send a test alert to verify configuration
#    curl -X POST http://localhost:9093/api/v1/alertmanagers/ping

# Security Notes:
# - Never commit .env file to version control (.gitignore is configured)
# - Use strong passwords for Grafana admin
# - Restrict access to monitoring endpoints via firewall
# - Consider using TLS for production deployments
