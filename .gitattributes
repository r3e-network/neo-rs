# Normalize line endings: LF in the repository for all text files; working
# tree line endings follow each platform's git configuration. Binary files
# are excluded by git's auto-detection.
* text=auto

# Source code
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Configuration
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf

# Build files
Makefile text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
*.so binary
*.dll binary
*.dylib binary
*.exe binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.bz2 binary
